rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function workspaceData(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn() && request.auth.uid in workspaceData(workspaceId).members.keys();
    }

    // Fields that decide who may do what. Only the owner may change them, so
    // ordinary data sync (tasks, notes, settings, ...) can never escalate a
    // member to owner or evict anyone.
    function protectedWorkspaceFields() {
      return ['members', 'ownerId', 'id', 'createdAt', 'schemaVersion'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------------

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------------
    // Workspaces
    // ---------------------------------------------------------------------

    match /workspaces/{workspaceId} {

      // A member joins by adding exactly their own entry, as a plain member,
      // and naming the invite that authorises it. The invite is verified here
      // rather than in the client, which anyone can bypass.
      function joiningViaInvite() {
        let uid = request.auth.uid;
        let newMember = request.resource.data.members[uid];
        let inviteId = newMember.inviteId;
        let invitePath = /databases/$(database)/documents/invites/$(inviteId);

        return !(uid in resource.data.members.keys())
          && changedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid])
          && newMember.uid == uid
          && newMember.role == 'member'
          && exists(invitePath)
          && get(invitePath).data.status == 'active'
          && get(invitePath).data.workspaceId == workspaceId;
      }

      function isOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }

      function memberDataUpdate() {
        return request.auth.uid in resource.data.members.keys()
          && !changedKeys().hasAny(protectedWorkspaceFields());
      }

      allow read: if signedIn() && request.auth.uid in resource.data.members.keys();

      // Create only your own workspace, with yourself as the sole owner member.
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].role == 'owner';

      // The owner may change anything, including membership. Everyone else may
      // only sync workspace content, and only if already a member — or add
      // themselves once, against a valid invite.
      allow update: if signedIn() && (isOwner() || memberDataUpdate() || joiningViaInvite());

      allow delete: if isOwner();

      // Shared content: one document per task, project, note or link, so two
      // members editing different items never write the same document. Any
      // member may write any item, which is the access the app already had
      // when everything lived in one document.
      match /items/{itemId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update, delete: if isWorkspaceMember(workspaceId);
      }

      // Assignment requests, one document each. The sender creates it; either
      // side can clear it by answering or withdrawing. Nothing edits one in
      // place, so an answered request cannot be rewritten into another state.
      match /requests/{requestId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId)
          && request.resource.data.fromId == request.auth.uid;
        allow delete: if isWorkspaceMember(workspaceId)
          && (resource.data.fromId == request.auth.uid
              || resource.data.toId == request.auth.uid);
        allow update: if false;
      }

      // Activity feed — members read; members append events attributed to
      // themselves. Events are immutable once written.
      match /activity/{eventId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Per-user private items (`{workspaceId}_{uid}`)
    // ---------------------------------------------------------------------

    match /private_workspaces/{docId} {
      allow read, write: if signedIn() && docId.matches('.*_' + request.auth.uid + '$');
    }

    // ---------------------------------------------------------------------
    // Invites
    // ---------------------------------------------------------------------

    match /invites/{inviteId} {
      // `get` only: an invitee opens a link and reads that one doc. Allowing
      // `list` would let any signed-in user enumerate every invite in the app.
      allow get: if signedIn();
      allow list: if false;

      // Only a workspace owner can mint an invite for that workspace. Without
      // this, anyone could forge an invite for a workspace id and walk in.
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.createdBy
        && workspaceData(request.resource.data.workspaceId).ownerId == request.auth.uid;

      allow update, delete: if signedIn() && request.auth.uid == resource.data.createdBy;
    }
  }
}
